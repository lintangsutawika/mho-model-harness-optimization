+async def _fail_if_cancelled_from_within(coro, name: str):
+    """Run a loop of the training task group; when a ``CancelledError`` escapes it while its own task is not being
+    cancelled (an awaited future or inner task was cancelled by someone else), log where and raise ``RuntimeError``
+    instead.  A task group ignores a child that ends cancelled: without this the run would wait forever on the
+    dispatcher and the rollout groups, with no step and no error (harnessforge: the 64kcap hangs of 2026-11-20/21)."""
+
+    try:
+        return await coro
+    except asyncio.CancelledError:
+        task = asyncio.current_task()
+        if task is None or task.cancelling():
+            raise
+        logger.exception(f"The {name} was cancelled from within (an awaited future was cancelled, its task was not); "
+                         "failing the run instead of hanging")
+        raise RuntimeError(f"the {name} was cancelled from within") from None
