+++ b/platoon/gateway/tito.py
@@ -0,0 +1,286 @@
+"""Token-in/token-out (TITO) prompts: each call of an agent extends the exact token stream of its previous call.
+
+Without TITO the gateway renders every call's messages from scratch.  The sampled tokens of the previous call then
+come back as the template's rendering of the message parsed from them, which differs whenever the model wrote
+something the template would not (other whitespace around the thinking or a tool call, a tool call that did not parse,
+several tool calls, a generation cut at ``max_tokens``), or whenever the same text tokenizes differently in context.
+The prompt then no longer extends the previous prompt + completion, and ``trajectory_to_data`` starts a new datum,
+which repeats the whole shared prefix in the batch.
+
+With TITO (:class:`TitoStitcher`, on by default; ``PLATOON_TITO=0`` turns it off) the gateway keeps, per agent, the
+exact stream of its last call (prompt tokens + sampled tokens, as sampled) and the request messages it came from
+(:class:`TitoSession`).  A new request whose messages are the previous request's, then the assistant message the
+gateway returned (compared by role, content, reasoning and tool calls, :func:`canonical_reply`), then at least one new
+message, is sampled on::
+
+    stream + [end token, when the previous completion was cut before its stop token] + suffix
+
+where ``suffix`` is the template's rendering of the new messages and the generation prompt: the text after the last
+assistant turn's end marker in a render of the whole conversation.  Earlier tokens are never re-rendered.  Any other
+request (the harness dropped or rewrote history, changed the tools or chat-template kwargs, or the template renders the
+earlier turns differently once the new messages follow, as Qwen3.5 drops past thinking after a new user query) is
+rendered from scratch, as without TITO, and starts a new stream (and so a new datum).
+
+What the model sees is unchanged except that its own earlier turns are its sampled tokens instead of a re-rendering of
+them.  Inserted tokens (the new messages, the template's glue, a repaired end token) are prompt tokens, so
+``trajectory_to_data`` masks them out of the loss with zero logprobs, and the sampled tokens keep their sampler logprobs.
+
+Only renderers that render whole conversations as text (``ChatTemplateRenderer``: ``render_text`` and stop tokens) are
+stitched; other renderers render as before.  ``PLATOON_TITO_VERIFY=1`` also decodes every stitched prompt and counts
+whether it equals the from-scratch rendering as text (``text_equal`` / ``text_differs`` in the agent's ``tito`` misc).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+TITO_ENV = "PLATOON_TITO"
+TITO_VERIFY_ENV = "PLATOON_TITO_VERIFY"
+# The agent misc key (and so trajectory misc key) of an agent's TITO counts.
+TITO_MISC_KEY = "tito"
+_FALSE = ("0", "false", "no", "off")
+# How often (in recorded calls) a gateway logs its TITO totals.
+_LOG_EVERY = 2000
+
+
+def tito_from_env(default: bool = True) -> bool:
+    """Whether TITO is on: ``PLATOON_TITO`` (``0``/``false``/``no``/``off`` turn it off), else ``default``."""
+    value = os.environ.get(TITO_ENV)
+    if value is None or not value.strip():
+        return default
+    return value.strip().lower() not in _FALSE
+
+
+def _verify_from_env() -> bool:
+    value = os.environ.get(TITO_VERIFY_ENV, "")
+    return bool(value.strip()) and value.strip().lower() not in _FALSE
+
+
+@dataclass(frozen=True)
+class TitoRequest:
+    """What :meth:`TitoStitcher.prepare` saw of a request, for the stream the call leaves once sampled."""
+
+    key: str  # tools + chat-template kwargs
+    messages: tuple[str, ...]  # canonical request messages
+    stitched: bool  # the prompt is the previous stream + suffix
+    reason: str  # "stitched", "first", or why the prompt was rendered from scratch
+    text_equal: bool | None = None  # PLATOON_TITO_VERIFY: the stitched prompt decodes to the from-scratch render
+
+
+@dataclass
+class TitoSession:
+    """An agent's exact token stream after its last recorded call, and the request it came from."""
+
+    key: str
+    messages: tuple[str, ...]
+    reply: str  # canonical_reply of the assistant message the gateway returned
+    tokens: list[int] = field(repr=False)  # prompt + sampled tokens, exactly as sampled
+    cut: bool  # the completion has no stop token at its end (cut at max_tokens)
+
+
+# --------------------------------------------------------------------------- canonical messages
+
+
+def _without_none(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _without_none(v) for k, v in value.items() if v is not None}
+    if isinstance(value, (list, tuple)):
+        return [_without_none(v) for v in value]
+    return value
+
+
+def _dumps(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, ensure_ascii=False, default=str)
+
+
+def canonical_messages(messages: Sequence[Mapping[str, Any]]) -> tuple[str, ...]:
+    """Each request message as the chat template gets it (``clean_messages``), as canonical JSON (``None`` fields
+    dropped), for comparing a request's history with the previous request's."""
+    from platoon.train.tinker.renderers.chat_template import clean_messages
+
+    return tuple(_dumps(_without_none(message)) for message in clean_messages(list(messages)))  # type: ignore[arg-type]
+
+
+def _text(value: Any) -> str:
+    from platoon.train.tinker.renderers.chat_template import content_text
+
+    return content_text(value).strip() if value is not None else ""
+
+
+def canonical_reply(message: Mapping[str, Any]) -> str:
+    """An assistant message by what makes it the same turn: role, content and reasoning (whitespace-trimmed, as the
+    chat templates render them; ``None`` is empty), and its tool calls' names and arguments (ids ignored).  The
+    gateway's own reply and the copy a harness sends back compare equal unless the harness changed the turn."""
+    from platoon.train.tinker.renderers.chat_template import tool_call_name_and_arguments
+
+    calls = []
+    for call in message.get("tool_calls") or ():
+        name, arguments = tool_call_name_and_arguments(call)
+        calls.append([name, dict(arguments)])
+    return _dumps(
+        {
+            "role": message.get("role"),
+            "content": _text(message.get("content")),
+            "reasoning": _text(message.get("reasoning_content")),
+            "tool_calls": calls,
+        }
+    )
+
+
+# --------------------------------------------------------------------------- the stitcher
+
+
+class TitoStitcher:
+    """Builds TITO prompts for one renderer (see the module docstring)."""
+
+    def __init__(self, renderer: Any, *, verify: bool | None = None) -> None:
+        self.renderer = renderer
+        self.tokenizer = renderer.tokenizer
+        self.stop_tokens = [int(t) for t in renderer.get_stop_sequences()]
+        self.stop_texts = {t: str(self.tokenizer.decode([t])) for t in self.stop_tokens}
+        self.verify = _verify_from_env() if verify is None else verify
+        # The end token's text, followed by a probe suffix, must tokenize as the end token then the suffix: a stream
+        # cut after the end token then tokenizes as the whole text would.
+        self._clean_boundary = {
+            t: self._encode(text + "\n<x>") == [t, *self._encode("\n<x>")] for t, text in self.stop_texts.items()
+        }
+
+    @staticmethod
+    def supports(renderer: Any) -> bool:
+        """Whether ``renderer`` renders whole conversations as text with token stop sequences."""
+        if not callable(getattr(renderer, "render_text", None)):
+            return False
+        try:
+            stops = renderer.get_stop_sequences()
+        except Exception:
+            return False
+        return bool(stops) and all(isinstance(t, int) and not isinstance(t, bool) for t in stops)
+
+    # ------------------------------------------------------------------ helpers
+    def _encode(self, text: str) -> list[int]:
+        return list(self.tokenizer.encode(text, add_special_tokens=False))
+
+    def _render(self, messages: Sequence[Mapping[str, Any]], request: Any, *, generate: bool) -> str:
+        kwargs = dict(getattr(request, "render_kwargs", None) or {})
+        return self.renderer.render_text(
+            list(messages),
+            tools=getattr(request, "tools", None) or None,
+            enable_thinking=kwargs.get("enable_thinking"),
+            preserve_thinking=kwargs.get("preserve_thinking"),
+            add_generation_prompt=generate,
+        )
+
+    @staticmethod
+    def request_key(request: Any) -> str:
+        return _dumps(
+            {"tools": getattr(request, "tools", None), "render": getattr(request, "render_kwargs", None)}
+        )
+
+    def _end_marker(self, text: str) -> tuple[int, int] | None:
+        """(end of the last stop token's text in ``text``, that token), or None."""
+        best: tuple[int, int] | None = None
+        for token, marker in self.stop_texts.items():
+            if not marker:
+                continue
+            at = text.rfind(marker)
+            if at >= 0 and (best is None or at + len(marker) > best[0]):
+                best = (at + len(marker), token)
+        return best
+
+    # ------------------------------------------------------------------ API
+    def start(self, request: Any, messages: Sequence[Mapping[str, Any]]) -> tuple[str, tuple[str, ...]]:
+        """(request key, canonical messages) of a request; raises as rendering would on malformed messages."""
+        return self.request_key(request), canonical_messages(messages)
+
+    def stitch(
+        self,
+        session: TitoSession,
+        messages: Sequence[Mapping[str, Any]],
+        request: Any,
+        key: str,
+        canonical: tuple[str, ...],
+    ) -> tuple[list[int] | None, str, bool | None]:
+        """(the TITO prompt, ``"stitched"``, text check) when the request extends the session's; else (None, why,
+        None), and the caller renders from scratch."""
+        n = len(session.messages)
+        if key != session.key:
+            return None, "request_changed", None
+        if canonical[:n] != session.messages:
+            return None, "history_changed", None
+        if len(canonical) <= n or canonical_reply(messages[n]) != session.reply:
+            return None, "reply_dropped_or_changed", None
+        if len(canonical) == n + 1:
+            return None, "no_new_messages", None
+        full = self._render(messages, request, generate=True)
+        history = self._render(messages[: n + 1], request, generate=False)
+        if not full.startswith(history):
+            return None, "rerender_differs", None
+        marker = self._end_marker(history)
+        if marker is None:
+            return None, "no_end_marker", None
+        cut, end_token = marker
+        if history[cut:].strip():
+            return None, "no_end_marker", None
+        if not self._clean_boundary.get(end_token, False):
+            return None, "unclean_boundary", None
+        tokens = list(session.tokens)
+        if session.cut:
+            tokens.append(end_token)  # the turn the template closes; a prompt token, so masked
+        elif not tokens or tokens[-1] != end_token:
+            return None, "other_stop_token", None
+        suffix = full[cut:]
+        prompt = tokens + self._encode(suffix)
+        text_equal = None
+        if self.verify:
+            text_equal = str(self.tokenizer.decode(prompt)) == full
+        return prompt, "stitched", text_equal
+
+    def session(self, request: TitoRequest, prompt_tokens: list[int], response: Any) -> TitoSession:
+        """The stream a sampled call leaves: its prompt and sampled tokens, and the reply the harness should echo."""
+        sampled = list(response.tokens)
+        return TitoSession(
+            key=request.key,
+            messages=request.messages,
+            reply=canonical_reply(response.message()),
+            tokens=list(prompt_tokens) + sampled,
+            cut=not sampled or sampled[-1] not in self.stop_texts,
+        )
+
+
+@dataclass
+class TitoTotals:
+    """A gateway's TITO counts, logged every few thousand calls."""
+
+    calls: int = 0
+    stitched: int = 0
+    reasons: dict[str, int] = field(default_factory=dict)
+
+    def count(self, request: TitoRequest) -> None:
+        self.calls += 1
+        self.stitched += int(request.stitched)
+        self.reasons[request.reason] = self.reasons.get(request.reason, 0) + 1
+        if self.calls % _LOG_EVERY == 0:
+            logger.info(
+                "TITO: %d of %d calls extended their agent's token stream; the others: %s",
+                self.stitched,
+                self.calls,
+                {k: v for k, v in sorted(self.reasons.items()) if k != "stitched"},
+            )
+
+
+def count_in_misc(misc: dict[str, Any], request: TitoRequest) -> None:
+    """Count a recorded call's TITO outcome in its agent's misc (-> trajectory misc ``tito``)."""
+    counts = misc.setdefault(TITO_MISC_KEY, {"stitched": 0, "fresh": 0, "reasons": {}})
+    counts["stitched" if request.stitched else "fresh"] += 1
+    reasons = counts["reasons"]
+    reasons[request.reason] = reasons.get(request.reason, 0) + 1
+    if request.text_equal is not None:
+        name = "text_equal" if request.text_equal else "text_differs"
+        counts[name] = counts.get(name, 0) + 1
