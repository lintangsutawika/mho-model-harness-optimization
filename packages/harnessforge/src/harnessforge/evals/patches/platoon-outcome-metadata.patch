+def _json_values(metadata: Mapping[str, Any]) -> dict[str, Any]:
+    """The entries of an outcome's metadata whose values are JSON (the record is written as JSON)."""
 
+    kept: dict[str, Any] = {}
+    for key, value in metadata.items():
+        try:
+            json.dumps(value)
+        except (TypeError, ValueError):
+            continue
+        kept[str(key)] = value
+    return kept
 
