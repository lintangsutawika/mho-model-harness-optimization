# Copy to .env (gitignored) and fill in. Values below are placeholders.

# --- storage ---------------------------------------------------------------
BASE_DIR=                      # node-local tmp/cache ($PBS_LOCALDIR); HF_DIR/TMP_DIR/SINGULARITY_* derive from it
USER_DATA=                     # persistent run/checkpoint/data root
BASE_SIF=                      # the single image knob: serves training and vLLM, and sif_cache/ sits beside it

# --- sandbox ---------------------------------------------------------------
HARBOR_ENV_TYPE=singularity
EXECUTOR_URL=http://127.0.0.1:8900
SINGULARITY_DOCKER_USERNAME=
SINGULARITY_DOCKER_PASSWORD=

# --- propose-phase LLM -----------------------------------------------------
OPTIMIZER_MODEL=
OPTIMIZER_LLM_BASE_URL=
OPTIMIZER_LLM_API_KEY=

WANDB_API_KEY=

# --- scheduler -------------------------------------------------------------
# Auto-detected unless pinned. Resources are per phase; QUEUE is the PBS queue or the
# SLURM partition, MHO_ACCOUNT is PBS -P / SLURM -A.
MHO_SCHEDULER=                 # pbs | slurm
MHO_ACCOUNT=

MHO_EVAL_QUEUE=
MHO_EVAL_NGPUS=1
MHO_EVAL_CPUS=8
MHO_EVAL_WALLTIME=17:00:00

MHO_PROPOSE_QUEUE=
MHO_PROPOSE_NGPUS=0            # harness mutation is CPU work; see the QOS note in the README
MHO_PROPOSE_WALLTIME=01:00:00

MHO_TRAIN_QUEUE=
MHO_TRAIN_NGPUS=
MHO_TRAIN_WALLTIME=

# PBS only: raw `-l select=` string and reservation resource type.
# MHO_EVAL_SELECT=
# MHO_EVAL_RTYPE=

# SLURM only: read by sbatch itself, not by the loop.
# SBATCH_QOS=
# SBATCH_MEM_PER_NODE=64G

# --- eval ------------------------------------------------------------------
# Must be smaller than MHO_EVAL_WALLTIME, or the scheduler kills the job mid-trial.
HARBOR_TIMEOUT_SECONDS=57600
VLLM_PORT=8000
